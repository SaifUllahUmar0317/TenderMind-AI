# =============================================================================
# TenderMind - AI Tender Management Platform
# Environment Configuration Template
#
# Instructions:
#   1. Copy this file: cp .env.example .env
#   2. Fill in the required values below
#   3. NEVER commit .env to source control
# =============================================================================

# LLM Provider (Options: groq | gemini | openai | offline_rag)
LLM_PROVIDER=groq

# LLM Model (Examples: llama-3.3-70b-versatile, gemini-1.5-pro-latest, gpt-4o)
LLM_MODEL=llama-3.3-70b-versatile

# API Keys - provide the key for your chosen LLM_PROVIDER
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Embedding Model (downloaded automatically on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Server Configuration
HOST=0.0.0.0
PORT=5000
FLASK_ENV=production

# File Upload Limits (bytes)
MAX_FILE_SIZE=52428800
COMBINER_MAX_FILE_SIZE=2147483648

# OCR Settings
OCR_DPI=300
OCR_LANG=eng

# Optional: Tesseract path (Windows only, if not in system PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: Email alert configuration
# RESEND_API_KEY=
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_TO=admin@yourcompany.com
